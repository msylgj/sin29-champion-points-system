# Database Configuration
DB_USER=archery_user
DB_PASSWORD=archery_pass
DB_NAME=archery_db
DB_PORT=5432
POSTGRES_DATA_PATH=./data/postgres

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
DEBUG=False

# Production Image Configuration
DOCKERHUB_NAMESPACE=your_dockerhub_namespace
# 1.5 是示例旧版标签；请换成要部署的已发布标签。项目不推送 latest。
IMAGE_TAG=1.5

# Vite 开发服务器允许访问的域名，多个值用逗号分隔
VITE_ALLOWED_HOSTS=example.com,localhost

# Vite 本地开发时可指定 API 代理；容器内保持默认 http://backend:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 管理口令的 SHA-256 十六进制值，同时用于签发和验证管理 JWT
# printf '%s' '你的明文口令' | sha256sum | cut -d ' ' -f 1
SECRET_KEY=replace_with_sha256_hex
